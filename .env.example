# SecureQuote Lite environment variables. Copy to .env.local for local work.
# On Vercel, set these in Project Settings -> Environment Variables. Never commit real values.

# --- Required to run the product ---
# Postgres connection string (Neon, Supabase, Railway, etc.). SQLAlchemy + psycopg format:
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require
# Random secret that signs login sessions. At least 32 characters. Generate: openssl rand -hex 32
SECUREQUOTE_SESSION_SECRET=
# Public URL of this deployment, no trailing slash. Used in emails and Stripe redirects.
SECUREQUOTE_BASE_URL=https://your-domain.example
# Set to true for the first deploy so tables are created at startup (safe to leave on; migrations are idempotent).
SECUREQUOTE_AUTO_MIGRATE=true

# --- Stripe ($49/month subscription) ---
STRIPE_SECRET_KEY=
# Signing secret of the webhook endpoint pointing at {SECUREQUOTE_BASE_URL}/securequote/api/stripe/webhook
STRIPE_WEBHOOK_SECRET=
# Price id of the $49/month recurring price (starts with price_)
STRIPE_MONTHLY_PRICE_ID=

# --- Email (Resend) ---
RESEND_API_KEY=
# A sender on a domain verified in Resend, e.g. "SecureQuote Lite <quotes@yourdomain.com>"
SECUREQUOTE_FROM_EMAIL=

# --- v1 product flags ---
# Customers pay businesses outside the app in v1. Keep false until Stripe Connect exists.
SECUREQUOTE_CUSTOMER_PAYMENTS_ENABLED=false
# Free quotes a business can create/send before it must subscribe.
SECUREQUOTE_TRIAL_QUOTES=3
# How many days a customer quote link stays valid.
SECUREQUOTE_QUOTE_LINK_DAYS=30

# --- Optional AI "Suggest a price" (leave provider empty to hide the button) ---
# openai or gemini. Configure only the chosen provider's key and model.
SECUREQUOTE_LITE_AI_PROVIDER=
OPENAI_API_KEY=
OPENAI_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=
AI_GATEWAY_TIMEOUT_SECONDS=30

# --- Legacy prototype only (applications/securequote_lite/app.py) ---
SECUREQUOTE_LITE_MAX_UPLOAD_BYTES=5242880
SECUREQUOTE_LITE_AUDIT_LOG=logs/audit.jsonl
